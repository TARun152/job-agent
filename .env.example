# Application
JOB_AGENT_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/job_agent.db
RESUME_DIR=./resume
TAILORED_DIR=./tailored
SESSIONS_DIR=./sessions

# Matching
MATCH_SCORE_THRESHOLD=0.55
MATCH_KEYWORD_STUFF_CAP=0.15
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Target search defaults
ROLE_KEYWORDS=AI engineer,backend engineer,ML engineer,NLP,RAG,LLM,Python,Java
LOCATIONS=India,Remote
REMOTE_OK=true
SALARY_FLOOR_INR=
NOTICE_PERIOD_DAYS=30

# Portal credentials (never commit real values)
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# Gmail OAuth (credentials file path; token stored separately)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./gmail_token.json
GMAIL_SENDER=

# Approval UI
QUEUE_HOST=127.0.0.1
QUEUE_PORT=8080

# Automation safety
APPLY_HEADLESS=false
APPLY_SLOW_MO_MS=120
MAX_DAILY_APPLIES=10
MAX_DAILY_DISCOVERIES=50
